{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trackflow.internal/schemas/telemetry/event-schemas.json",
  "title": "TrackFlow Telemetry Event Schemas",
  "description": "JSON Schema draft-07 definitions for all TrackFlow telemetry events. See docs/telemetry/telemetry-plan.md for rationale and delivery strategy.",
  "definitions": {
    "envelopeBase": {
      "type": "object",
      "required": [
        "eventId",
        "timestamp",
        "sessionId",
        "userId",
        "event_type",
        "schemaVersion",
        "requestId",
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for this event instance (UUID v4)."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "UTC emission time in ISO 8601 format."
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "description": "Browser session identifier (UUID v4)."
        },
        "userId": {
          "type": "string",
          "description": "Pseudonymous user UUID from JWT claims, or 'anonymous'."
        },
        "event_type": {
          "type": "string",
          "description": "Entity-action taxonomy event name."
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the event schema."
        },
        "requestId": {
          "type": "string",
          "description": "Correlation ID from X-Request-ID header."
        },
        "properties": {
          "type": "object",
          "description": "Event-specific payload. Keys must match the event allowlist."
        }
      }
    },
    "warehouseLocation": {
      "type": "string",
      "enum": ["los_angeles", "zaragoza"]
    },
    "sessionStartedProperties": {
      "type": "object",
      "required": ["auth_method"],
      "additionalProperties": false,
      "properties": {
        "auth_method": {
          "type": "string",
          "enum": ["password"]
        },
        "is_admin": {
          "type": "boolean"
        }
      }
    },
    "credentialFailedProperties": {
      "type": "object",
      "required": ["email_hash", "failure_reason"],
      "additionalProperties": false,
      "properties": {
        "email_hash": {
          "type": "string",
          "description": "SHA-256 hash of attempted email."
        },
        "failure_reason": {
          "type": "string",
          "enum": ["invalid_credentials", "account_inactive"]
        }
      }
    },
    "sessionExpiredProperties": {
      "type": "object",
      "required": ["last_page", "session_duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "last_page": {
          "type": "string"
        },
        "session_duration_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "productCreatedProperties": {
      "type": "object",
      "required": ["product_id", "sku", "warehouse_location", "client_brand"],
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "warehouse_location": {
          "$ref": "#/definitions/warehouseLocation"
        },
        "client_brand": {
          "type": "string"
        },
        "low_stock_threshold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "productCreateRejectedProperties": {
      "type": "object",
      "required": ["sku", "rejection_reason"],
      "additionalProperties": false,
      "properties": {
        "sku": {
          "type": "string"
        },
        "rejection_reason": {
          "type": "string",
          "enum": ["duplicate_sku"]
        },
        "existing_product_id": {
          "type": "integer"
        }
      }
    },
    "inboundOrderCreatedProperties": {
      "type": "object",
      "required": [
        "order_id",
        "product_id",
        "sku",
        "quantity",
        "warehouse_location",
        "client_brand"
      ],
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "type": "integer"
        },
        "product_id": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "warehouse_location": {
          "$ref": "#/definitions/warehouseLocation"
        },
        "client_brand": {
          "type": "string"
        }
      }
    },
    "outboundOrderCreatedProperties": {
      "type": "object",
      "required": [
        "order_id",
        "product_id",
        "sku",
        "quantity",
        "warehouse_location",
        "resulting_stock"
      ],
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "type": "integer"
        },
        "product_id": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "warehouse_location": {
          "$ref": "#/definitions/warehouseLocation"
        },
        "resulting_stock": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outboundOrderRejectedProperties": {
      "type": "object",
      "required": [
        "product_id",
        "sku",
        "requested_quantity",
        "available_stock",
        "rejection_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "requested_quantity": {
          "type": "integer",
          "minimum": 1
        },
        "available_stock": {
          "type": "integer",
          "minimum": 0
        },
        "rejection_reason": {
          "type": "string",
          "enum": ["insufficient_stock"]
        }
      }
    },
    "stockThresholdTriggeredProperties": {
      "type": "object",
      "required": [
        "product_id",
        "sku",
        "current_stock",
        "low_stock_threshold",
        "warehouse_location",
        "client_brand"
      ],
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "integer"
        },
        "sku": {
          "type": "string"
        },
        "current_stock": {
          "type": "integer",
          "minimum": 0
        },
        "low_stock_threshold": {
          "type": "integer",
          "minimum": 0
        },
        "warehouse_location": {
          "$ref": "#/definitions/warehouseLocation"
        },
        "client_brand": {
          "type": "string"
        }
      }
    },
    "pageViewedProperties": {
      "type": "object",
      "required": ["page_path"],
      "additionalProperties": false,
      "properties": {
        "page_path": {
          "type": "string"
        },
        "referrer_path": {
          "type": "string"
        }
      }
    },
    "formAbandonedProperties": {
      "type": "object",
      "required": ["form_type", "elapsed_seconds"],
      "additionalProperties": false,
      "properties": {
        "form_type": {
          "type": "string",
          "enum": ["inbound", "outbound", "product"]
        },
        "last_field": {
          "type": "string"
        },
        "elapsed_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sessionStartedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "session_started" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/sessionStartedProperties" }
          }
        }
      ]
    },
    "credentialFailedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "credential_failed" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/credentialFailedProperties" }
          }
        }
      ]
    },
    "sessionExpiredEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "session_expired" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/sessionExpiredProperties" }
          }
        }
      ]
    },
    "productCreatedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "product_created" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/productCreatedProperties" }
          }
        }
      ]
    },
    "productCreateRejectedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "product_create_rejected" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/productCreateRejectedProperties" }
          }
        }
      ]
    },
    "inboundOrderCreatedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "inbound_order_created" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/inboundOrderCreatedProperties" }
          }
        }
      ]
    },
    "outboundOrderCreatedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "outbound_order_created" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/outboundOrderCreatedProperties" }
          }
        }
      ]
    },
    "outboundOrderRejectedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "outbound_order_rejected" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/outboundOrderRejectedProperties" }
          }
        }
      ]
    },
    "stockThresholdTriggeredEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "stock_threshold_triggered" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/stockThresholdTriggeredProperties" }
          }
        }
      ]
    },
    "pageViewedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "page_viewed" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/pageViewedProperties" }
          }
        }
      ]
    },
    "formAbandonedEvent": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "properties": {
            "event_type": { "const": "form_abandoned" },
            "schemaVersion": { "const": "1.0.0" },
            "properties": { "$ref": "#/definitions/formAbandonedProperties" }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/sessionStartedEvent" },
    { "$ref": "#/definitions/credentialFailedEvent" },
    { "$ref": "#/definitions/sessionExpiredEvent" },
    { "$ref": "#/definitions/productCreatedEvent" },
    { "$ref": "#/definitions/productCreateRejectedEvent" },
    { "$ref": "#/definitions/inboundOrderCreatedEvent" },
    { "$ref": "#/definitions/outboundOrderCreatedEvent" },
    { "$ref": "#/definitions/outboundOrderRejectedEvent" },
    { "$ref": "#/definitions/stockThresholdTriggeredEvent" },
    { "$ref": "#/definitions/pageViewedEvent" },
    { "$ref": "#/definitions/formAbandonedEvent" }
  ]
}
