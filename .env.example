# Backend (inventory-api) — SQLite works out of the box for local Docker dev
DATABASE_URL=sqlite:///./trackflow.db
SECRET_KEY=change-me-to-a-random-secret
TINYDB_PATH=trackflow_auth.json
ACCESS_TOKEN_EXPIRE_MINUTES=30

# For production/Supabase, override in a local .env file:
# DATABASE_URL=postgresql://user:password@host:6543/postgres

# Frontend (future API integration)
NEXT_PUBLIC_API_URL=http://backend:8000
