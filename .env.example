REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://trackflow:trackflow@localhost:5432/trackflow
UPLOAD_DIR=/tmp/trackflow_uploads

# Canonical local service URLs
WEBSITE_API_URL=http://localhost:4000
AUTH_API_URL=http://localhost:8000
INCIDENTS_API_URL=http://localhost:8001
SUPPLIER_API_URL=http://localhost:8002
INVENTORY_API_URL=http://localhost:8003
TALENT_API_URL=http://localhost:8004/tracker/api/v1
OPERATIONS_API_URL=http://localhost:8005

# Browser-visible service URLs
NEXT_PUBLIC_WEBSITE_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000
NEXT_PUBLIC_INCIDENTS_API_URL=http://localhost:8001
NEXT_PUBLIC_SUPPLIER_API_URL=http://localhost:8002
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8003
NEXT_PUBLIC_TALENT_API_URL=http://localhost:8004/tracker/api/v1
NEXT_PUBLIC_OPERATIONS_API_URL=http://localhost:8005
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8005/telemetry/events

# Authentication
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_PATH=./data/trackflow_auth.json

# RAG / Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trackflow_knowledge

# 4Geeks LiteLLM gateway (OpenAI-compatible)
# Docs: https://llm.4geeks.ai
OPENAI_API_KEY=replace-with-your-4geeks-litellm-secret-key
OPENAI_BASE_URL=https://llm.4geeks.ai/v1
EMBEDDING_MODEL=downtown-miami/openrouter/perplexity/pplx-embed-v1-0.6b
EMBEDDING_VECTOR_SIZE=1024
GENERATION_MODEL=downtown-miami/groq/llama-3.1-8b-instant
RAG_MIN_SCORE=0.55

# Agent tools
INCIDENT_TOOL_TIMEOUT_SECONDS=5.0

# MCP company-tools server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8006
MCP_SERVER_URL=http://localhost:8006/mcp
MCP_RESOURCE_URL=http://localhost:8006/mcp
MCP_OIDC_ISSUER=https://your-logto-tenant.logto.app/oidc
MCP_JWKS_URI=https://your-logto-tenant.logto.app/oidc/jwks
MCP_AUDIENCE=http://localhost:8006/mcp
MCP_AGENT_ACCESS_TOKEN=replace-with-oauth-access-token
INVENTORY_SERVICE_TOKEN=replace-with-inventory-api-jwt
MCP_AUTH_TEST_MODE=1
MCP_TEST_JWT_SECRET=local-development-secret-change-me
MCP_BACKEND_TIMEOUT_SECONDS=10.0
